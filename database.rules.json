{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "audit": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".validate": "newData.hasChildren(['at','action','by'])",
        "$o": {
          ".validate": true
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "rateCents": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000 && newData.val() % 1 === 0"
      },
      "startPoints": {
        ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
      },
      "defaultQuota": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
      },
      "paidPointMode": {
        ".validate": "newData.val() === 'points' || newData.val() === 'zero'"
      },
      "currency": {
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 4"
      },
      "autoReset": {
        ".validate": "newData.isBoolean()"
      },
      "resetWeekday": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7"
      },
      "weekNo": {
        ".write": "root.child('settings/autoReset').val() === true && newData.val() === data.val() + 1",
        ".validate": "newData.isNumber()"
      },
      "weekId": {
        ".write": "root.child('settings/autoReset').val() === true && newData.parent().child('weekNo').val() === data.parent().child('weekNo').val() + 1",
        ".validate": "newData.isString() && newData.val().matches(/^w[0-9]+$/)"
      },
      "weekStart": {
        ".write": "root.child('settings/autoReset').val() === true && newData.parent().child('weekNo').val() === data.parent().child('weekNo').val() + 1",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      },
      "$other": {
        ".validate": false
      }
    },
    "members": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$m": {
        ".validate": "$m.matches(/^m[1-5]$/) && newData.hasChildren(['name','quota'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "quota": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tasks": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$t": {
        ".validate": "newData.hasChildren(['name','kind','points','max','active','order','slots'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "desc": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "kind": {
          ".validate": "newData.val() === 'regular' || newData.val() === 'paid'"
        },
        "points": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0"
        },
        "max": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20 && newData.val() % 1 === 0"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "order": {
          ".validate": "newData.isNumber()"
        },
        "slots": {
          "$s": {
            ".validate": "newData.val() === true && $s.matches(/^s([1-9]|1[0-9]|20)$/)"
          }
        },
        "claim": {
          ".write": "(newData.exists() && (!data.exists() || data.child('week').val() !== root.child('settings/weekId').val())) || (!newData.exists() && data.exists() && !root.child('completions').child(data.child('week').val() + '_' + $t + '_s1').exists())",
          ".validate": "newData.hasChildren(['member','week']) && newData.child('member').val().matches(/^m[1-5]$/) && newData.child('week').val().matches(/^w[0-9]+$/) && (auth != null && root.child('admins').child(auth.uid).val() === true || newData.child('week').val() === root.child('settings/weekId').val())",
          "member": {
            ".validate": "newData.isString()"
          },
          "week": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "completions": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$key": {
        ".write": "(!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && data.child('kind').val() === 'regular' && data.child('week').val() === root.child('settings/weekId').val())",
        ".validate": "newData.hasChildren(['member','memberName','task','taskName','kind','week','weekStart','slot','points','at']) && (newData.child('kind').val() === 'regular' || newData.hasChildren(['minutes','rateCents','paymentCents'])) && (auth != null && root.child('admins').child(auth.uid).val() === true || ($key === newData.child('week').val() + '_' + newData.child('task').val() + '_' + newData.child('slot').val() && !newData.child('voided').exists()))",
        "member": {
          ".validate": "newData.isString() && newData.val().matches(/^m[1-5]$/) && (auth != null && root.child('admins').child(auth.uid).val() === true || newData.parent().child('memberName').val() === root.child('members').child(newData.val()).child('name').val())"
        },
        "memberName": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "task": {
          ".validate": "newData.isString()"
        },
        "taskName": {
          ".validate": "newData.isString() && newData.val().length <= 80 && (auth != null && root.child('admins').child(auth.uid).val() === true || newData.val() === root.child('tasks').child(newData.parent().child('task').val()).child('name').val())"
        },
        "kind": {
          ".validate": "(newData.val() === 'regular' || newData.val() === 'paid') && (auth != null && root.child('admins').child(auth.uid).val() === true || newData.val() === root.child('tasks').child(newData.parent().child('task').val()).child('kind').val())"
        },
        "week": {
          ".validate": "newData.isString() && (auth != null && root.child('admins').child(auth.uid).val() === true || newData.val() === root.child('settings/weekId').val())"
        },
        "weekStart": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "slot": {
          ".validate": "newData.isString() && (auth != null && root.child('admins').child(auth.uid).val() === true || root.child('tasks').child(newData.parent().child('task').val()).child('slots').child(newData.val()).val() === true)"
        },
        "points": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && (auth != null && root.child('admins').child(auth.uid).val() === true || newData.val() === (newData.parent().child('kind').val() === 'paid' && root.child('settings/paidPointMode').val() === 'zero' ? 0 : root.child('tasks').child(newData.parent().child('task').val()).child('points').val()))"
        },
        "minutes": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 720 && newData.parent().child('kind').val() === 'paid'"
        },
        "rateCents": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000 && newData.parent().child('kind').val() === 'paid' && (auth != null && root.child('admins').child(auth.uid).val() === true || newData.val() === root.child('settings/rateCents').val())"
        },
        "paymentCents": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.parent().child('kind').val() === 'paid' && (auth != null && root.child('admins').child(auth.uid).val() === true || (newData.val() * 60 >= newData.parent().child('minutes').val() * newData.parent().child('rateCents').val() - 30 && newData.val() * 60 <= newData.parent().child('minutes').val() * newData.parent().child('rateCents').val() + 30))"
        },
        "at": {
          ".validate": "newData.isNumber() && (auth != null && root.child('admins').child(auth.uid).val() === true || newData.val() === now)"
        },
        "voided": {
          ".validate": "newData.isBoolean() && auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "voidReason": {
          ".validate": "newData.isString() && newData.val().length <= 200 && auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "edited": {
          ".validate": "newData.isBoolean() && auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}